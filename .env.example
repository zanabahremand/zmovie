# Zmovie — Environment Variables Example
# =========================================
# Copy this file to `.env` and fill in your values.
#
# For GitHub Pages deployment:
#   - Set NEXT_PUBLIC_TMDB_API_KEY and NEXT_PUBLIC_TMDB_API_READ_TOKEN
#     as GitHub Repository Secrets (not in this file).
#   - The GitHub Action will inject them during build.

# ────────── TMDB API (REQUIRED for the app to work) ──────────
# Get a free API key at https://www.themoviedb.org/settings/api
# These are public (NEXT_PUBLIC_*) because TMDB is free with rate limits.
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here
NEXT_PUBLIC_TMDB_API_READ_TOKEN=your_tmdb_api_read_access_token_here
NEXT_PUBLIC_TMDB_LANG=fa-IR

# ────────── Optional: GitHub Pages sub-path ──────────
# If deploying to https://username.github.io/zmovie/ (not root),
# uncomment and set BASE_PATH to /zmovie (or your repo name).
# For root deployment (repo named "username.github.io"), leave empty.
# BASE_PATH=/zmovie
